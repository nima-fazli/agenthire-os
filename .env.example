AGENTHIRE_APP_NAME=AgentHire OS API
AGENTHIRE_APP_VERSION=0.1.0
AGENTHIRE_ENVIRONMENT=local
AGENTHIRE_DEBUG=true
AGENTHIRE_LOG_LEVEL=INFO

AGENTHIRE_API_PORT=8000

AGENTHIRE_POSTGRES_HOST=127.0.0.1
AGENTHIRE_POSTGRES_PORT=5435
AGENTHIRE_POSTGRES_DB=agenthire
AGENTHIRE_POSTGRES_USER=agenthire
AGENTHIRE_POSTGRES_PASSWORD=change-me

AGENTHIRE_JWT_SECRET=change-me-with-a-secure-random-secret
AGENTHIRE_JWT_ALGORITHM=HS256
AGENTHIRE_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local agent portfolio (compose.agents.yaml enables the service)
AGENTHIRE_AGENTS_ENABLED=false
AGENTHIRE_AGENT_MODEL=qwen3:4b
AGENTHIRE_AGENT_NUM_THREADS=4
AGENTHIRE_AGENT_MAIL_HOST=127.0.0.1
AGENTHIRE_AGENT_MAIL_PORT=1025
